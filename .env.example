# ============================================================
# LasangPinoy Mobile - Environment Variables Template
# ------------------------------------------------------------
# Copy this file to `.env` in the project root and fill in
# the values. Never commit the real `.env` to git.
# ============================================================

# --- Firebase Configuration ---
# Get these from: https://console.firebase.google.com/
# Project Settings -> General -> Your apps -> Web app
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# --- Lamion AI primary inference tier (chat + vision routing) ---
# Keys for this tier are issued through the Lamion AI console.
# NOTE: the variable name below is load-bearing (referenced in code) — do not rename it.
EXPO_PUBLIC_LAMION_API_KEY=your_lamion_primary_key

# --- Lamion AI fallback tier (automatic fallback when the primary tier is rate-limited) ---
# Keys for this tier are issued through the Lamion AI console.
EXPO_PUBLIC_LAMION_ROUTER_API_KEY=your_lamion_fallback_key

# --- Lamion AI flagship vision backend (free tier) ---
# Keys for this tier are issued through the Lamion AI console.
EXPO_PUBLIC_LAMION_VISION_API_KEY=your_lamion_vision_key

# --- Cloudinary (image uploads) ---
# Get from: https://console.cloudinary.com/
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
